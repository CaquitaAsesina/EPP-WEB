# ============================================================
# Variables de entorno - Copiar como .env y llenar con tus datos
# NO subir .env a repositorios
# ============================================================

# Modo de base de datos: cloud (Aiven) o local (MySQL)
DB_MODE=cloud

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Aiven Cloud MySQL (DB_MODE=cloud) ----
DB_HOST=tu-host.aivencloud.com
DB_PORT=26056
DB_USER=avnadmin
DB_PASSWORD=tu_password_aiven
DB_NAME=defaultdb
DB_SSL=true

# ---- Local MySQL (DB_MODE=local) ----
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=tu_password_local
LOCAL_DB_NAME=inventario_epp
LOCAL_DB_SSL=false

# ---- JWT ----
JWT_SECRET=genera_un_secret_largo_aleatorio

# ---- Opcional: script deploy-aiven.js (uso local) ----
# EPP_DB_HOST=tu-host.aivencloud.com
# EPP_DB_PORT=26056
# EPP_DB_USER=avnadmin
# EPP_DB_PASSWORD=tu_password_aiven
# EPP_DB_NAME=defaultdb
# EPP_DB_SSL=true
